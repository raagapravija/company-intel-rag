# Copy to .env and fill in. Never commit .env.
# Default setup costs $0 and needs no credit card.

# --- Neo4j (local Docker) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j
# Read-only user used by Text2Cypher so generated queries can't modify data (phase 2)
NEO4J_READONLY_USER=reader
NEO4J_READONLY_PASSWORD=change-me-too

# --- Embeddings + reranking ---
# "local" = BGE-M3 + bge-reranker on your machine (free; models download once, ~3 GB)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
RERANK_PROVIDER=local
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Optional: Voyage instead (200M free tokens/model; set providers to "voyage",
# EMBEDDING_MODEL=voyage-4-large, RERANK_MODEL=rerank-2.5)
VOYAGE_API_KEY=

# --- LLM: any OpenAI-compatible endpoint ---
# Groq free tier (no card): get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Fully offline alternative with Ollama (https://ollama.com), after `ollama pull qwen3:8b`:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b

# Ragas judge: a different model from the one answering; keep it fixed across runs
EVAL_JUDGE_BASE_URL=https://api.groq.com/openai/v1
EVAL_JUDGE_MODEL=openai/gpt-oss-120b
# EVAL_JUDGE_API_KEY=   (defaults to LLM_API_KEY)

# --- SEC EDGAR ---
# SEC requires a descriptive User-Agent with a contact email
SEC_USER_AGENT="company-intel-rag your-email@example.com"

# --- Tracing (optional, Langfuse free tier) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
