# Copy to .env and fill in. Never commit .env.

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j
# Read-only user used by Text2Cypher so generated queries can't modify data (phase 2)
NEO4J_READONLY_USER=reader
NEO4J_READONLY_PASSWORD=change-me-too

# --- Embeddings + reranking (Voyage AI) ---
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-large
EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=rerank-2.5

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Judge model for Ragas; keep it fixed so scores are comparable across runs
EVAL_JUDGE_MODEL=claude-opus-5-5

# --- SEC EDGAR ---
# SEC requires a descriptive User-Agent with a contact email
SEC_USER_AGENT="company-intel-rag your-email@example.com"

# --- Tracing (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
